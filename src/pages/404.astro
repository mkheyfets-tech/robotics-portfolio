---
import MainLayout from '../layouts/Layout.astro';
---
<MainLayout title="Page not found — Mark">
  <section class="notfound">
    <p class="eyebrow">Error 404</p>
    <h1>This page went out of range.</h1>
    <p class="notfound-body">
      The link is broken or the page has moved. Everything that does exist is on the work index.
    </p>
    <a href="https://mkheyfets-tech.github.io/robotics-portfolio/" class="notfound-link">Back to work</a>
  </section>
</MainLayout>

<style>
  .notfound {
    max-width: var(--shell);
    margin: 0 auto;
    padding: clamp(5rem, 16vw, 11rem) var(--gutter) 0 var(--gutter);
    position: relative;
    z-index: var(--z-content);
  }

  .notfound h1 {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    margin: 0.75rem 0 0 -0.03em;
    max-width: 16ch;
  }

  .notfound-body {
    margin: 1.75rem 0 0 0;
    max-width: 40ch;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .notfound-link {
    display: inline-block;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .notfound-link::before { content: '← '; }

  .notfound-link:hover {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }
</style>
