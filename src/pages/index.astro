---
import MainLayout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// @ts-ignore
const projects = (Object.values(import.meta.glob('./projects/*.md', { eager: true })) as any[])
  .sort((a, b) => (a.frontmatter.order ?? 0) - (b.frontmatter.order ?? 0));
const engineering = projects.filter(p => p.frontmatter.category !== 'research');
const research = projects.filter(p => p.frontmatter.category === 'research');
---
<MainLayout>
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> ROBOTICS / SOFTWARE / AUTONOMY</p>
      <h1 id="intro-title">Making robots<br />sense, plan<span class="accent">,</span><br />and move<span class="accent">.</span></h1>
      <p class="hero-intro">I'm Mark, a robotics engineering student at WPI. I work across mechanical design and software to turn sensor data into useful action.</p>
      <div class="hero-actions"><a class="button" href="#projects">Explore my work <span aria-hidden="true">↓</span></a><a class="text-link" href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">View resume <span aria-hidden="true">↗</span></a></div>
    </div>
    <aside class="hero-portrait" aria-label="About Mark">
      <div class="portrait-frame"><img src={`${base}/headshot.jpg`} width="640" height="640" alt="Mark Kheyfets" fetchpriority="high" /><span class="portrait-corner" aria-hidden="true">+</span></div>
      <div class="portrait-caption"><span>MARK KHEYFETS</span><span>WORCESTER, MA</span></div>
      <p>Curious about how things work.<br />More curious about making them work.</p>
    </aside>
  </section>
  <div class="focus-strip shell" aria-label="Areas of focus"><span>FROM HARDWARE TO BEHAVIOR</span><p>Robot control <i>/</i> Computer vision <i>/</i> Motion planning <i>/</i> Applied AI</p></div>
  <section id="about" class="about-section shell" aria-labelledby="about-title">
    <div><p class="eyebrow">01 / A LITTLE ABOUT ME</p><h2 id="about-title">I like working where<br />disciplines overlap<span class="accent">.</span></h2></div>
    <div class="about-copy"><p>I'm studying Robotics Engineering at Worcester Polytechnic Institute and also pursuing my MS at WPI, with expected completion in 2028. My projects span robot mechanisms, embedded control, computer vision, and autonomous decision-making.</p><p>I enjoy connecting those pieces: understanding the mechanics, writing the control logic, and seeing how the system behaves in practice. Research with OpenStar also gave me a chance to explore how people understand and respond to new technology.</p><a class="text-link" href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">More about my experience ↗</a></div>
  </section>
  <section id="projects" class="work-section shell" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2 id="work-title">Engineering in practice<span class="accent">.</span></h2></div></div>
    <div class="project-grid">
      {engineering.map((project, index) => (
        <a href={project.url} class="project-card">
          <div class={`project-image ${project.frontmatter.imageClass || ''}`}><img src={project.frontmatter.image} alt={project.frontmatter.imageAlt || project.frontmatter.title} width="1006" height="910" loading="lazy" /><span class="image-arrow" aria-hidden="true">↗</span></div>
          <div class="card-heading"><p class="eyebrow">{project.frontmatter.discipline}</p><span class={index === 0 ? "latest-label" : "project-number"}>{index === 0 ? "LATEST PROJECT" : `0${index + 1}`}</span></div>
          <h3>{project.frontmatter.title}</h3><p class="card-summary">{project.frontmatter.summary}</p>
          <div class="tags">{project.frontmatter.tech.map((tool: string) => <span>{tool}</span>)}</div>
          <span class="card-link">Explore project <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
  <section class="research-section shell" aria-labelledby="research-title">
    <div class="section-heading"><div><p class="eyebrow">03 / BEYOND THE BUILD</p><h2 id="research-title">Technology meets people<span class="accent">.</span></h2></div></div>
    {research.map(project => <a class="research-card" href={project.url}><div class="research-image"><img src={project.frontmatter.image} width="1006" height="910" alt="OpenStar fusion research project" loading="lazy" /></div><div class="research-copy"><p class="eyebrow">RESEARCH & COMMUNICATION</p><h3>{project.frontmatter.title}</h3><p>{project.frontmatter.summary}</p><div class="tags">{project.frontmatter.tech.map((tool: string) => <span>{tool}</span>)}</div><span class="card-link">Read the research <span aria-hidden="true">↗</span></span></div></a>)}
  </section>
  <section class="contact-section shell" aria-labelledby="contact-title"><div><p class="eyebrow">LET'S CONNECT</p><h2 id="contact-title">Have something in mind?</h2><p>I'd be glad to talk about robotics, engineering, or a project you're working on.</p></div><a class="button" href="mailto:mkheyfets@wpi.edu">Get in touch <span aria-hidden="true">↗</span></a></section>
</MainLayout>
