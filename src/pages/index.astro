---
import MainLayout from '../layouts/Layout.astro';

// @ts-ignore
const allProjects = Object.values(import.meta.glob('./projects/*.md', { eager: true })) as any[];

const RESEARCH_TITLES = ['Nuclear Fusion Sentiment Analysis'];
const engineering = allProjects.filter(p => !RESEARCH_TITLES.includes(p.frontmatter.title));
const research = allProjects.filter(p => RESEARCH_TITLES.includes(p.frontmatter.title));
---
<MainLayout>
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Robotics Engineer</p>
      <h1 class="hero-title">Hi, I&rsquo;m Mark.</h1>
      <p class="hero-blurb">
        I build robots and sometimes even the software that makes them move.
        Currently studying Robotics Engineering at Worcester Polytechnic Institute.
      </p>
      <div class="hero-links">
        <a href="mailto:mkheyfets@wpi.edu">Get in touch</a>
        <a href="/robotics-portfolio/resume.pdf" target="_blank" rel="noopener">Resume</a>
        <a href="https://github.com/mkheyfets-tech" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>

    <div class="hero-portrait">
      <img src="/robotics-portfolio/headshot.jpg" alt="Portrait of Mark" />
    </div>
  </header>

  <section id="work" class="work" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading" class="eyebrow">Selected work</h2>
      <span class="section-count">{String(engineering.length).padStart(2, '0')} projects</span>
    </div>

    {engineering.map((project, i) => (
      <a href={project.url} class:list={['work-item', 'reveal', { flip: i % 2 === 1 }]}>
        <div class="work-media">
          <img src={project.frontmatter.image} alt={project.frontmatter.title} loading="lazy" />
        </div>
        <div class="work-body">
          <span class="work-index">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="work-title">{project.frontmatter.title}</h3>
          <p class="work-summary">{project.frontmatter.summary}</p>
          <dl class="work-spec">
            {project.frontmatter.course && (
              <div class="work-spec-row">
                <dt>Course</dt>
                <dd>{project.frontmatter.course}</dd>
              </div>
            )}
            <div class="work-spec-row">
              <dt>Stack</dt>
              <dd>{project.frontmatter.tech.join(' · ')}</dd>
            </div>
          </dl>
          <span class="work-cta">View project<span class="work-arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </section>

  {research.length > 0 && (
    <section id="research" class="work" aria-labelledby="research-heading">
      <div class="section-head">
        <h2 id="research-heading" class="eyebrow">Research &amp; strategy</h2>
        <span class="section-count">{String(research.length).padStart(2, '0')} project</span>
      </div>

      {research.map((project, i) => (
        <a href={project.url} class:list={['work-item', 'reveal', { flip: i % 2 === 1 }]}>
          <div class="work-media">
            <img src={project.frontmatter.image} alt={project.frontmatter.title} loading="lazy" />
          </div>
          <div class="work-body">
            <span class="work-index">{String(engineering.length + i + 1).padStart(2, '0')}</span>
            <h3 class="work-title">{project.frontmatter.title}</h3>
            <p class="work-summary">{project.frontmatter.summary}</p>
            <dl class="work-spec">
              {project.frontmatter.course && (
                <div class="work-spec-row">
                  <dt>Programme</dt>
                  <dd>{project.frontmatter.course}</dd>
                </div>
              )}
              <div class="work-spec-row">
                <dt>Methods</dt>
                <dd>{project.frontmatter.tech.join(' · ')}</dd>
              </div>
            </dl>
            <span class="work-cta">View project<span class="work-arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </section>
  )}

  <section class="contact" aria-labelledby="contact-heading">
    <p class="eyebrow" id="contact-heading">Get in touch</p>
    <p class="contact-line">
      Open to robotics internships and collaboration.
      <a href="mailto:mkheyfets@wpi.edu">mkheyfets@wpi.edu</a>
    </p>
  </section>
</MainLayout>

<script>
  // Header hairline appears only once the page has scrolled
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Quiet entrance — skipped entirely when the user prefers reduced motion
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll('.reveal');

  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  .hero {
    max-width: var(--shell);
    margin: 0 auto;
    padding: clamp(3.5rem, 11vw, 8rem) var(--gutter) clamp(4rem, 10vw, 7rem) var(--gutter);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    position: relative;
    z-index: var(--z-content);
  }

  .hero-copy { grid-column: 1 / 8; }

  .hero-title {
    font-size: clamp(3.25rem, 11vw, 7.5rem);
    margin: 0.75rem 0 0 -0.05em;
  }

  .hero-blurb {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0 0;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero-links a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .hero-links a:hover {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

  .hero-portrait {
    grid-column: 9 / 13;
    align-self: end;
  }

  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    display: block;
    border-radius: 2px;
    filter: var(--img-tone);
    transition: filter 0.6s ease;
  }

  .hero-portrait img:hover { filter: none; }

  /* ============================================================
     WORK INDEX
     Full-width alternating rows rather than a card grid.
     ============================================================ */
  .work {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--gutter);
    position: relative;
    z-index: var(--z-content);
  }

  .work + .work { margin-top: clamp(5rem, 11vw, 9rem); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--rule);
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .work-item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    text-decoration: none;
    color: inherit;
    margin-bottom: clamp(5rem, 11vw, 9rem);
  }

  .work-item:last-child { margin-bottom: 0; }

  .work-media {
    grid-column: 1 / 8;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  .work-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    filter: var(--img-tone);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }

  .work-body { grid-column: 8 / 13; }

  /* Alternate sides so the eye zig-zags down the page */
  .work-item.flip .work-media { grid-column: 6 / 13; grid-row: 1; }
  .work-item.flip .work-body { grid-column: 1 / 6; grid-row: 1; }

  /* Index reads as a small superior numeral against the serif title */
  .work-index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    vertical-align: 1.4em;
    margin-right: 0.6rem;
    transition: color 0.3s ease;
  }

  .work-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.05;
    margin: 0;
    display: inline;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    padding-bottom: 0.08em;
  }

  .work-summary {
    margin: 1.25rem 0 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .work-spec {
    margin: 1.75rem 0 0 0;
    border-top: 1px solid var(--rule);
  }

  .work-spec-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .work-spec dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.15rem;
  }

  .work-spec dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .work-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .work-arrow {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-item:hover .work-media img,
  .work-item:focus-visible .work-media img {
    transform: scale(1.035);
    filter: none;
  }

  .work-item:hover .work-title,
  .work-item:focus-visible .work-title { background-size: 100% 1px; }

  .work-item:hover .work-arrow,
  .work-item:focus-visible .work-arrow { transform: translateX(6px); }

  .work-item:hover .work-cta,
  .work-item:focus-visible .work-cta { color: var(--signal); }

  .work-item:hover .work-index,
  .work-item:focus-visible .work-index { color: var(--signal); }

  /* ============================================================
     CONTACT
     ============================================================ */
  .contact {
    max-width: var(--shell);
    margin: clamp(6rem, 14vw, 11rem) auto 0 auto;
    padding: clamp(3rem, 7vw, 5rem) var(--gutter) 0 var(--gutter);
    position: relative;
    z-index: var(--z-content);
  }

  /* Rule is inset to the gutter so it lines up with the content edge
     rather than the padding box */
  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--rule);
  }

  .contact-line {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 1.25rem 0 0 0;
    max-width: 22ch;
  }

  .contact-line a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    transition: color 0.25s ease, border-color 0.25s ease;
    white-space: nowrap;
  }

  .contact-line a:hover {
    color: var(--signal);
    border-bottom-color: var(--signal);
  }

  /* ============================================================
     ENTRANCE
     ============================================================ */
  :global(html.js-reveal) .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html.js-reveal) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1000px) {
    .hero-copy { grid-column: 1 / 9; }
    .hero-portrait { grid-column: 9 / 13; }
    .work-body,
    .work-item.flip .work-body { grid-column: 8 / 13; grid-row: 1; }
    .work-media,
    .work-item.flip .work-media { grid-column: 1 / 8; grid-row: 1; }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: clamp(2.5rem, 9vw, 4rem);
      align-items: start;
    }
    .hero-copy { grid-column: 1 / 13; grid-row: 2; }
    .hero-portrait {
      grid-column: 1 / 8;
      grid-row: 1;
      margin-bottom: 0.5rem;
    }
    .hero-portrait img { aspect-ratio: 3 / 2; object-position: center 25%; }

    .work-item { gap: 1.5rem; }
    .work-media,
    .work-item.flip .work-media {
      grid-column: 1 / 13;
      grid-row: 1;
    }
    .work-body,
    .work-item.flip .work-body {
      grid-column: 1 / 13;
      grid-row: 2;
    }
    .work-summary { max-width: none; }
  }
</style>
