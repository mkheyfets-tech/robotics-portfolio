---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { frontmatter, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const pageTitle = frontmatter ? `${frontmatter.title} — Mark Kheyfets` : title || 'Mark Kheyfets — Robotics Engineering';
const description = frontmatter?.summary || 'Robotics engineering portfolio of Mark Kheyfets. Projects in robot control, computer vision, autonomous planning, and applied research.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try { theme = localStorage.getItem('theme') || 'light'; } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href={home} aria-label="Mark Kheyfets, home"><span class="monogram">MK<span>.</span></span><span class="brand-name">Mark Kheyfets<span>Robotics Engineering</span></span></a>
      <nav aria-label="Main navigation">
        <a href={`${home}#projects`}>Projects</a>
        <a href={`${home}#about`}>About</a>
        <a href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><svg class="theme-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/></svg></button>
      </nav>
    </header>
    {frontmatter ? (
      <main id="main" class="project-main shell">
        <a href={`${home}#projects`} class="back-link">← All projects</a>
        <header class="project-heading">
          <p class="eyebrow">{frontmatter.discipline || 'Engineering project'}</p>
          <h1>{frontmatter.title}</h1>
          <p class="project-deck">{frontmatter.summary}</p>
          <div class="project-meta"><span>{frontmatter.context}</span><div class="tags">{frontmatter.tech.map((tool: string) => <span>{tool}</span>)}</div></div>
        </header>
        <article class="project-body"><slot /></article>
        <a class="back-link project-end" href={`${home}#projects`}>← Explore the other projects</a>
      </main>
    ) : <main id="main"><slot /></main>}
    <footer class="site-footer shell">
      <div><a class="footer-name" href={home}>Mark Kheyfets<span>.</span></a><p>Robotics, software, and the space between.</p></div>
      <div class="footer-links"><a href="mailto:mkheyfets@wpi.edu">Email ↗</a><a href="https://github.com/mkheyfets-tech" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={`${base}/resume.pdf`} target="_blank" rel="noopener noreferrer">Resume ↗</a></div>
    </footer>
    <script>
      function storedTheme() {
        try { return localStorage.getItem('theme') || 'light'; } catch { return 'light'; }
      }
      function syncTheme() {
        const dark = document.documentElement.dataset.theme === 'dark';
        const button = document.getElementById('theme-toggle');
        button?.setAttribute('aria-pressed', String(dark));
        button?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
      }
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset.theme = storedTheme();
        syncTheme();
      });
      document.addEventListener('astro:page-load', () => {
        syncTheme();
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          try { localStorage.setItem('theme', theme); } catch {}
          syncTheme();
        });
      });
    </script>
  </body>
</html>
